diff --git a/meson.build b/meson.build
index e2f7992..b500ff9 100644
--- a/meson.build
+++ b/meson.build
@@ -72,8 +72,26 @@ if vulkan_dep.found()
   sources += 'backends/imgui_impl_vulkan.cpp'
   dependencies += vulkan_dep
 endif
-if cpp.has_header('webgpu/webgpu.h', required: get_option('webgpu'))
+# Dawn is not on the default include path. Look it up the same way xemu does
+# so webgpu.h is visible when the option is enabled. Emscripten uses the
+# emdawnwebgpu port instead of a native Dawn package.
+wgpu_cpp_args = []
+if not get_option('webgpu').disabled() and host_machine.system() == 'emscripten'
   sources += 'backends/imgui_impl_wgpu.cpp'
+  wgpu_cpp_args += ['-DIMGUI_IMPL_WEBGPU_BACKEND_DAWN', '--use-port=emdawnwebgpu']
+elif not get_option('webgpu').disabled()
+  dawn_dep = dependency('dawn', method: 'pkg-config', required: false)
+  if not dawn_dep.found()
+    dawn_dep = dependency('Dawn', method: 'cmake', modules: ['dawn::webgpu_dawn'], required: false)
+  endif
+  if not dawn_dep.found()
+    dawn_dep = dependency('webgpu_dawn', required: get_option('webgpu'))
+  endif
+  if dawn_dep.found()
+    sources += 'backends/imgui_impl_wgpu.cpp'
+    dependencies += dawn_dep
+    wgpu_cpp_args += '-DIMGUI_IMPL_WEBGPU_BACKEND_DAWN'
+  endif
 endif
 
 # platform backends
@@ -118,7 +136,7 @@ endif
 imgui = library(
   'imgui',
   sources,
-  cpp_args: api,
+  cpp_args: [api] + wgpu_cpp_args,
   gnu_symbol_visibility: 'hidden',
   dependencies: dependencies,
   include_directories: include_dirs,
